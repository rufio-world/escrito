{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "pirepe/grid",
  "title": "Pirepe Grid",
  "category": "layout",
  "icon": "grid-view",
  "description": "A responsive grid container for layout sections.",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "minColumnWidth": {
      "type": "string",
      "default": "220px"
    },
    "gap": {
      "type": "string",
      "default": "md"
    }
  },
  "editorScript": "pirepe-theme-blocks",
  "editorStyle": "pirepe-theme-editor",
  "style": "pirepe-theme-frontend"
}
