{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "escrito/container",
  "title": "Escrito Container",
  "category": "layout",
  "icon": "screenoptions",
  "description": "A flex-based container with builder-focused controls.",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "layout": {
      "type": "object",
      "default": {
        "type": "flex",
        "allowSizingOnChildren": true,
        "justifyContent": "flex-start",
        "flexWrap": "wrap"
      }
    },
    "builderSettings": {
      "type": "object",
      "default": {
        "stackOnMobile": true,
        "gap": "md"
      }
    }
  },
  "editorScript": "escrito-builder-blocks",
  "editorStyle": "escrito-builder-editor",
  "style": "escrito-builder-frontend"
}
