{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "escrito/columns",
  "title": "Escrito Columns",
  "category": "layout",
  "icon": "columns",
  "description": "A column set with responsive stacking.",
  "attributes": {
    "columns": {
      "type": "number",
      "default": 2
    },
    "gap": {
      "type": "string",
      "default": "md"
    },
    "stackOnMobile": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "escrito-builder-blocks",
  "editorStyle": "escrito-builder-editor",
  "style": "escrito-builder-frontend"
}
